    "item": [
        {
            "name": "Campaign Management",
            "description": "\nAPI endpoints for managing campaign sending and statistics",
            "item": [
                {
                    "name": "Send a campaign",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/campaigns\/:id\/send",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/campaigns\/:id\/send",
                            "variable": [
                                {
                                    "id": "id",
                                    "key": "id",
                                    "value": "1",
                                    "description": "The ID of the campaign to send."
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Sends the campaign to all active subscribers in the associated newsletter.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\n  \"success\": true,\n  \"message\": \"Campaign sent successfully: 10 sent, 0 failed\",\n  \"sent_count\": 10,\n  \"failed_count\": 0\n}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 400,
                            "body": "{\n  \"success\": false,\n  \"message\": \"This campaign has already been sent\"\n}",
                            "name": ""
                        }
                    ]
                },
                {
                    "name": "Schedule a campaign",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
